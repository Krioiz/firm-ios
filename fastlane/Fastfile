default_platform(:ios)
platform :ios do
  desc "Signed development build, installable over the air on registered devices"
  lane :build do
    setup_ci
    api = app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_content: ENV["ASC_KEY_P8"], is_key_content_base64: false)
    ids = ["com.getstubbie.firm", "com.getstubbie.firm.widget"]
    group = "group.com.getstubbie.firm"

    # The widget shares a container with the app, so both App IDs need the App Groups
    # capability and the group itself must exist. Idempotent: skips what is already there.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key: ENV["ASC_KEY_P8"])
    ids.each do |bid|
      create_app_online(app_identifier: bid, app_name: (bid.end_with?("widget") ? "The Firm Widget" : "The Firm"),
                        skip_itc: true, api_key: api, team_id: ENV["APPLE_TEAM_ID"])
    end
    bundle_ids = Spaceship::ConnectAPI::BundleId.all
    groups = Spaceship::ConnectAPI::AppGroup.all rescue []
    ag = groups.find { |g| g.identifier == group } || Spaceship::ConnectAPI::AppGroup.create(identifier: group, name: "The Firm")
    ids.each do |bid|
      b = bundle_ids.find { |x| x.identifier == bid }
      next unless b
      caps = b.get_capabilities.map(&:capability_type) rescue []
      unless caps.include?("APP_GROUPS")
        b.create_capability(Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS, settings: [], capability_type: "APP_GROUPS")
      end
    end
    # associate the group with both bundle ids (Apple requires the relationship explicitly)
    ids.each do |bid|
      b = bundle_ids.find { |x| x.identifier == bid }
      begin
        Spaceship::ConnectAPI.post_bundle_id_capability(bundle_id_id: b.id, capability_type: "APP_GROUPS",
          settings: [], relationships: { capability: { data: [{ type: "appGroups", id: ag.id }] } })
      rescue => e
        UI.message("app group association for #{bid}: #{e.message[0, 120]}")
      end
    end

    match(type: "development", app_identifier: ids, api_key: api, readonly: false,
          git_url: "https://github.com/Krioiz/firm-ios.git", git_branch: "certs",
          git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV['GITHUB_TOKEN']}"),
          force_for_new_devices: true, force: ENV["MATCH_FORCE"] == "1")
    sh "cd .. && xcodegen generate"
    build_app(project: "Firm.xcodeproj", scheme: "Firm", configuration: "Release", export_method: "development",
              output_directory: "out", output_name: "Firm.ipa",
              export_options: { method: "development",
                                provisioningProfiles: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] },
              xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} CODE_SIGN_IDENTITY='Apple Development' CODE_SIGN_STYLE=Manual")
  end
end
