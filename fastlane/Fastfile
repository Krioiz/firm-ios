default_platform(:ios)

# Shared setup: an App Store Connect API key, the two bundle ids registered, and xcodegen run.
# Both lanes need all of it, and getting it wrong once cost an afternoon of signing errors.
def prepare(type, ids = nil)
  setup_ci
  api = app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"],
                                  key_content: ENV["ASC_KEY_P8"], is_key_content_base64: false)
  ids ||= ["com.getstubbie.firm", "com.getstubbie.firm.widget"]
  # The widget is a second bundle id; Apple must know about it before match asks for a profile.
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key: ENV["ASC_KEY_P8"])
  existing = Spaceship::ConnectAPI::BundleId.all.map(&:identifier)
  ids.each do |bid|
    next if existing.include?(bid)
    nice = if bid.end_with?("widget") then "The Firm Widget"
           elsif bid.end_with?("sizer") then "Max Sizer"
           else "The Firm" end
    Spaceship::ConnectAPI::BundleId.create(name: nice, identifier: bid, platform: "IOS")
    UI.message("created bundle id #{bid}")
  end
  match(type: type, app_identifier: ids, api_key: api, readonly: false,
        git_url: "https://github.com/Krioiz/firm-ios.git", git_branch: "certs",
        git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV['GITHUB_TOKEN']}"),
        force_for_new_devices: true, force: ENV["MATCH_FORCE"] == "1")
  # project.yml names the Development profile on both targets. match makes AppStore profiles for
  # the appstore type, so Xcode goes looking for a profile that does not exist and the archive
  # fails with "No profile for team ... matching 'match Development ...'". Rewrite the specifier
  # per target rather than forcing one profile onto both through xcargs — the app and the widget
  # have different bundle ids and therefore different profiles.
  if type == "appstore"
    spec = File.read("../project.yml")
    File.write("../project.yml", spec.gsub("match Development ", "match AppStore "))
    UI.message("project.yml switched to the AppStore profiles")
  end
  sh "cd .. && xcodegen generate"
  api
end

# A scheme that is not shared is not an error to fastlane — it picks whichever scheme it can find
# and archives that instead. That is how a Max Sizer build spent four minutes archiving The Firm
# and then failed on a profile it never asked for. Refuse up front and name the schemes we got.
def require_scheme(name)
  dir = "../Firm.xcodeproj/xcshareddata/xcschemes"
  have = Dir.exist?(dir) ? Dir.children(dir).grep(/\.xcscheme\z/).map { |f| File.basename(f, ".xcscheme") } : []
  return if have.include?(name)
  UI.user_error!("scheme '#{name}' is not shared, so fastlane would silently build something " \
                 "else. project.yml must declare it under `schemes:`. Shared now: #{have.sort.join(', ')}")
end

platform :ios do
  desc "Signed development build, installable over the air on registered devices"
  lane :device do
    prepare("development")
    require_scheme("Firm")
    build_app(project: "Firm.xcodeproj", scheme: "Firm", configuration: "Release",
              export_method: "development", output_directory: "out", output_name: "Firm.ipa",
              export_options: { method: "development",
                                provisioningProfiles: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] },
              xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} CODE_SIGN_IDENTITY='Apple Development' CODE_SIGN_STYLE=Manual")
  end

  # The one that produces an app you can actually install anywhere. TestFlight has no device
  # registration and no 7-day expiry, and the build stays available for 90 days.
  desc "App Store signed build, uploaded to TestFlight"
  lane :testflight do
    api = prepare("appstore")
    require_scheme("Firm")
    build_app(project: "Firm.xcodeproj", scheme: "Firm", configuration: "Release",
              export_method: "app-store", output_directory: "out", output_name: "Firm.ipa",
              export_options: { method: "app-store",
                                provisioningProfiles: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] },
              xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} CODE_SIGN_IDENTITY='Apple Distribution' CODE_SIGN_STYLE=Manual")
    # TestFlight needs an app record to upload into. `produce` rejects api_key outright —
    # "Could not find option 'api_key'" — so the record is created through Spaceship, whose
    # token prepare() has already set. A DRAFT record only: nothing is submitted for review and
    # nothing becomes public.
    #
    # The listing name must be unique across the whole App Store and is NOT what shows on the
    # home screen; that comes from CFBundleDisplayName, which stays "The Firm".
    begin
      existing = Spaceship::ConnectAPI::App.find("com.getstubbie.firm")
      if existing
        UI.message("app record already exists: #{existing.name}")
      else
        Spaceship::ConnectAPI::App.create(
          name: ENV["ASC_APP_NAME"] || "The Firm by Stubbie",
          version_string: "6.2",
          sku: "com.getstubbie.firm",
          primary_locale: "en-US",
          bundle_id: "com.getstubbie.firm",
          platforms: ["IOS"])
        UI.success("created the App Store Connect record")
      end
    rescue => e
      # Most likely an unsigned Apple agreement or a name already taken — both are Marco's to
      # clear, and the message says which.
      UI.important("could not create the app record: #{e.message}")
    end
    upload_to_testflight(api_key: api,
                         skip_waiting_for_build_processing: true,
                         # Nothing to review for internal testers, so no compliance questionnaire.
                         skip_submission: true)
  end

  desc "Old name for :device, kept so an existing bookmark still works"
  lane :build do
    device
  end

  # ---- Max Sizer -------------------------------------------------------------------------
  # A separate app with its own bundle id, built from the same project. Nothing it does depends
  # on the dashboard, so it ships on its own schedule.
  SIZER_IDS = ["com.getstubbie.sizer"]

  desc "Max Sizer — development build, installable on registered devices"
  lane :sizer_device do
    prepare("development", SIZER_IDS)
    require_scheme("Sizer")
    build_app(project: "Firm.xcodeproj", scheme: "Sizer", configuration: "Release",
              export_method: "development", output_directory: "out", output_name: "MaxSizer.ipa",
              export_options: { method: "development",
                                provisioningProfiles: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] },
              xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} CODE_SIGN_IDENTITY='Apple Development' CODE_SIGN_STYLE=Manual")
  end

  desc "Max Sizer — App Store signed, uploaded to TestFlight"
  lane :sizer_testflight do
    api = prepare("appstore", SIZER_IDS)
    require_scheme("Sizer")
    build_app(project: "Firm.xcodeproj", scheme: "Sizer", configuration: "Release",
              export_method: "app-store", output_directory: "out", output_name: "MaxSizer.ipa",
              export_options: { method: "app-store",
                                provisioningProfiles: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] },
              xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} CODE_SIGN_IDENTITY='Apple Distribution' CODE_SIGN_STYLE=Manual")
    upload_to_testflight(api_key: api, app_identifier: "com.getstubbie.sizer",
                         skip_waiting_for_build_processing: true, skip_submission: true)
  end
end
