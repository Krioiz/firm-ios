default_platform(:ios)
platform :ios do
  desc "Signed development build, installable over the air on registered devices"
  lane :build do
    setup_ci
    api = app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_content: ENV["ASC_KEY_P8"], is_key_content_base64: false)
    match(type: "development", app_identifier: "com.getstubbie.firm", api_key: api, readonly: false,
          git_url: "https://github.com/Krioiz/firm-ios.git", git_branch: "certs",
          git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV['GITHUB_TOKEN']}"),
          force_for_new_devices: true)
    sh "cd .. && xcodegen generate"
    build_app(project: "Firm.xcodeproj", scheme: "Firm", configuration: "Release", export_method: "development",
              output_directory: "out", output_name: "Firm.ipa",
              xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} PROVISIONING_PROFILE_SPECIFIER='match Development com.getstubbie.firm' CODE_SIGN_IDENTITY='Apple Development' CODE_SIGN_STYLE=Manual")
  end
end
